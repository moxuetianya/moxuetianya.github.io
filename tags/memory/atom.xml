&lt;tr&gt;&lt;td&gt;GOT&#x2F;PLT&lt;&#x2F;td&gt;&lt;td&gt;Global Offset Table &#x2F; Procedure Linkage Table&lt;&#x2F;td&gt;&lt;&#x2F;tr&gt;
&lt;tr&gt;&lt;td&gt;UAF&lt;&#x2F;td&gt;&lt;td&gt;Use After Free&lt;&#x2F;td&gt;&lt;&#x2F;tr&gt;
